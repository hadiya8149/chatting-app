li.new_msg {
    position: relative;
    margin-left: 20px;
    margin-bottom: 10px;
    padding: 10px;
    list-style-type: none;
    width: 200px;
    height: 50px;
    background-color: #A8DDFD;
    text-align: left;
    font: 400 .9em 'Open Sans', sans-serif;
    border: 1px solid #97C6E3;
    border-radius: 10px;
}

li.new_msg:after {
    content: '';
    position: absolute;
    width: 0;
    height: 0;
    border-top: 15px solid #A8DDFD;
    border-left: 15px solid transparent;
    border-right: 15px solid transparent;
    top: 0;
    left: -15px;
}

